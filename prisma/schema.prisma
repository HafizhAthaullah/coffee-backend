generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CUSTOMER
}

enum OrderStatus {
  pending
  waiting_payment
  paid
  on_process
  ready
  completed
  cancelled
}

enum Kategori {
  coffee //Kopi yang diseduh dengan mesin espresso untuk menghasilkan rasa yang kuat dan konsentrasi tinggi.
  non_coffee //Produk non-kopi seperti makanan atau minuman lainnya.
  food //Makanan yang dijual di kedai kopi.
  snack //Makanan ringan atau camilan yang biasanya disajikan di kedai kopi, seperti kue, pastry, atau roti.
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)

  pesanan   Pesanan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id          Int      @id @default(autoincrement())
  nama        String
  harga       Int
  deskripsi   String
  kategori    Kategori
  image       String?
  tersedia    Boolean  @default(true)

  pesanan     Pesanan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pesanan {
  id          Int         @id @default(autoincrement())

  userId      Int
  menuId      Int
  jumlah      Int         @default(1)
  catatan     String?

  status      OrderStatus @default(pending)

  user        User        @relation(fields: [userId], references: [id])
  menu        Menu        @relation(fields: [menuId], references: [id])

  transaksi   Transaksi?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Transaksi {
  id           Int      @id @default(autoincrement())

  pesananId    Int      @unique
  total        Int
  metode_bayar String?
  bukti        String?

  pesanan      Pesanan  @relation(fields: [pesananId], references: [id])

  createdAt    DateTime @default(now())
}
